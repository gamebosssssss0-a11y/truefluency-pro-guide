# Copy this file to .env and fill in your own values.
# NEVER commit real keys. Set these as environment variables on Render instead.

# Supabase project that the FRONTEND uses (must be the same project, or the
# backend will report "Material not found" for every upload).
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# OpenRouter key used for topic prediction and mock generation.
OPENROUTER_API_KEY=""

# Comma-separated list of allowed browser origins. Leave empty to allow all
# (development only).
ALLOWED_ORIGINS=""
