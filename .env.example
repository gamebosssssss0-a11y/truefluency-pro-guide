# TrueFluency Pro — environment template
#
# Copy to .env and fill in values from YOUR Supabase project
# (Project Settings -> API). Then run: bun run check:env
#
# RULES ENFORCED BY scripts/check-env.mjs:
#  - every VITE_* value must match its non-VITE twin
#  - SUPABASE_URL must be https://<SUPABASE_PROJECT_ID>.supabase.co
#  - publishable/anon keys only; secret keys must NEVER appear here
#  - the service role key lives in the secret store, not in this file

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"

# Document analysis backend
VITE_BACKEND_URL="https://truefluency-pro-backend.onrender.com"

# NOT IN THIS FILE (stored as project secrets, server-side only):
#   SERVICE_ROLE_KEY   -> sb_secret_... admin key used by library.server.ts
#   SB_URL             -> optional override of SUPABASE_URL for server code
